@model LibraryReportViewModel
@{ ViewData["Title"] = "Library Report"; }
<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h1 class="h3 fw-bold mb-0"><i class="fas fa-book-open me-2 text-primary"></i>Library Report</h1>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm"><i class="fas fa-print me-2"></i>Print</button>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm"><i class="fas fa-arrow-left me-2"></i>Reports</a>
    </div>
</div>
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-3"><div class="h3 fw-bold text-primary">@Model.TotalBooks</div><div class="small text-muted">Book Titles</div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-3"><div class="h3 fw-bold text-info">@Model.TotalCopies</div><div class="small text-muted">Total Copies</div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-3"><div class="h3 fw-bold text-warning">@Model.IssuedCopies</div><div class="small text-muted">Currently Issued</div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-3"><div class="h3 fw-bold text-danger">@Model.OverdueIssues.Count</div><div class="small text-muted">Overdue</div></div></div>
</div>
<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3"><h6 class="fw-semibold mb-0"><i class="fas fa-chart-bar me-2 text-primary"></i>Most Issued Books</h6></div>
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light"><tr><th>Title</th><th>Author</th><th>Times Issued</th></tr></thead>
                    <tbody>
                        @foreach (var b in Model.MostIssuedBooks) {
                            <tr><td class="small fw-semibold">@b.Title</td><td class="small text-muted">@b.Author</td><td><span class="badge bg-primary">@b.Issues.Count</span></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between">
                <h6 class="fw-semibold mb-0"><i class="fas fa-exclamation-triangle me-2 text-danger"></i>Overdue Returns</h6>
                <div><span class="badge bg-success">Fines Collected: $@Model.TotalFinesCollected</span> <span class="badge bg-danger ms-1">Pending: $@Model.TotalFinesPending</span></div>
            </div>
            <div class="card-body p-0">
                @if (Model.OverdueIssues.Any())
                {
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light"><tr><th>Student</th><th>Book</th><th>Due</th><th>Days</th></tr></thead>
                        <tbody>
                            @foreach (var i in Model.OverdueIssues)
                            {
                                var days = (int)(DateTime.Today - i.DueDate).TotalDays;
                                <tr class="table-warning"><td class="small fw-semibold">@i.Student?.FullName</td><td class="small">@i.Book?.Title</td><td class="small text-danger">@i.DueDate.ToString("MMM dd")</td><td><span class="badge bg-danger">@days d</span></td></tr>
                            }
                        </tbody>
                    </table>
                }
                else { <p class="text-center text-success py-3 small"><i class="fas fa-check-circle me-1"></i>No overdue books!</p> }
            </div>
        </div>
    </div>
</div>
