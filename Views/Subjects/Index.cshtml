@model IEnumerable<Subject>
@{ ViewData["Title"] = "Subjects"; }

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <div><h1 class="h3 mb-0 fw-bold"><i class="fas fa-book me-2 text-info"></i>Subjects</h1><p class="text-muted mb-0">Manage school curriculum</p></div>
    <a asp-action="Create" class="btn btn-info text-white"><i class="fas fa-plus me-2"></i>Add Subject</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr><th>Subject</th><th>Code</th><th>Class</th><th>Teacher</th><th>Credits</th><th>Total Marks</th><th>Pass Marks</th><th class="text-center">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@s.Name</td>
                            <td><code>@s.Code</code></td>
                            <td>@(s.Class?.FullName ?? "<span class='text-muted'>—</span>")</td>
                            <td>@(s.Teacher?.FullName ?? "<span class='text-muted'>Unassigned</span>")</td>
                            <td><span class="badge bg-info">@s.CreditHours</span></td>
                            <td>@s.TotalMarks</td>
                            <td><span class="@(s.PassMarks <= 40 ? "text-success" : "text-warning") fw-semibold">@s.PassMarks</span></td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-outline-info"><i class="fas fa-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-outline-primary"><i class="fas fa-edit"></i></a>
                                    <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-outline-danger"><i class="fas fa-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center py-5 text-muted"><i class="fas fa-book fa-2x mb-2 d-block opacity-25"></i>No subjects added yet</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
