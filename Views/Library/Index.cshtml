@model IEnumerable<Book>
@{ ViewData["Title"] = "Library"; }

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <div><h1 class="h3 mb-0 fw-bold"><i class="fas fa-book-open me-2 text-purple"></i>Library</h1><p class="text-muted mb-0">Book catalogue and issue management</p></div>
    <div class="d-flex gap-2">
        <a asp-action="IssuedBooks" class="btn btn-outline-info"><i class="fas fa-list me-2"></i>Issued Books</a>
        <a asp-action="IssueBook" class="btn btn-outline-warning"><i class="fas fa-hand-holding-heart me-2"></i>Issue Book</a>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Add Book</a>
    </div>
</div>

<!-- Stats -->
<div class="row g-4 mb-4">
    <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-3"><div class="h4 fw-bold text-primary">@ViewBag.TotalBooks</div><div class="text-muted small">Total Books</div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-3"><div class="h4 fw-bold text-warning">@ViewBag.IssuedBooks</div><div class="text-muted small">Currently Issued</div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-3"><div class="h4 fw-bold text-success">@(ViewBag.TotalBooks - ViewBag.IssuedBooks)</div><div class="text-muted small">Available</div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-3"><div class="h4 fw-bold text-danger">@ViewBag.OverdueBooks</div><div class="text-muted small">Overdue</div></div></div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <div class="input-group"><span class="input-group-text"><i class="fas fa-search"></i></span><input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Title, Author, ISBN..."></div>
            </div>
            <div class="col-md-3">
                <select name="category" class="form-select">
                    <option value="">All Categories</option>
                    @foreach (var c in (List<string>)ViewBag.Categories) { <option value="@c" selected="@(ViewBag.Category==c)">@c</option> }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary me-2"><i class="fas fa-search me-1"></i>Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-times"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr><th>Accession</th><th>Title</th><th>Author</th><th>Category</th><th>Shelf</th><th>Copies</th><th>Available</th><th>Status</th><th class="text-center">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td><code class="small">@b.AccessionNo</code></td>
                            <td>
                                <div class="fw-semibold">@b.Title</div>
                                @if (!string.IsNullOrEmpty(b.ISBN)) { <small class="text-muted">@b.ISBN</small> }
                            </td>
                            <td class="small">@b.Author</td>
                            <td><span class="badge bg-light text-dark">@b.Category</span></td>
                            <td class="small text-muted">@b.ShelfLocation</td>
                            <td class="text-center">@b.TotalCopies</td>
                            <td class="text-center">
                                <span class="fw-bold @(b.AvailableCopies > 0 ? "text-success" : "text-danger")">@b.AvailableCopies</span>
                            </td>
                            <td>
                                @switch (b.Status) {
                                    case BookStatus.Available: <span class="badge bg-success">Available</span> break;
                                    case BookStatus.Issued:    <span class="badge bg-warning text-dark">Issued</span> break;
                                    case BookStatus.Lost:      <span class="badge bg-danger">Lost</span> break;
                                    case BookStatus.Damaged:   <span class="badge bg-secondary">Damaged</span> break;
                                    default: <span class="badge bg-info">@b.Status</span> break;
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-outline-info"><i class="fas fa-eye"></i></a>
                                    <a asp-action="IssueBook" asp-route-bookId="@b.Id" class="btn btn-outline-warning" title="Issue"><i class="fas fa-hand-holding-heart"></i></a>
                                    <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-outline-primary"><i class="fas fa-edit"></i></a>
                                    <a asp-action="Delete" asp-route-id="@b.Id" class="btn btn-outline-danger"><i class="fas fa-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any()) { <tr><td colspan="9" class="text-center py-5 text-muted"><i class="fas fa-book fa-2x mb-2 d-block opacity-25"></i>No books found</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.Any()) { <div class="card-footer bg-white"><small class="text-muted">@Model.Count() book(s) shown</small></div> }
</div>
