@model IEnumerable<Grade>
@{ Layout = "~/Views/StudentPortal/_LayoutStudent.cshtml"; ViewData["Title"] = "My Grades"; var student = (Student)ViewBag.Student; }
<h4 class="fw-bold mb-4"><i class="fas fa-star me-2 text-warning"></i>My Grades</h4>
@if (Model.Any())
{
    var avg = Model.Average(g => (double)g.Percentage);
    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-3"><div class="h3 fw-bold" style="color:#6610f2">@Math.Round(avg,1)%</div><div class="small text-muted">Overall Average</div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-3"><div class="h3 fw-bold text-success">@Model.Count(g => g.Percentage >= 40)</div><div class="small text-muted">Passed</div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-3"><div class="h3 fw-bold text-danger">@Model.Count(g => g.Percentage < 40)</div><div class="small text-muted">Failed</div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-3"><div class="h3 fw-bold text-primary">@Model.Count()</div><div class="small text-muted">Total Exams</div></div></div>
    </div>
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark"><tr><th>Subject</th><th>Exam Type</th><th>Date</th><th>Score</th><th>%</th><th>Grade</th><th>Result</th></tr></thead>
                <tbody>
                    @foreach (var g in Model)
                    {
                        var gc = g.LetterGrade switch { "A+" or "A" => "success", "B" => "primary", "C" => "warning", _ => "danger" };
                        <tr>
                            <td class="fw-semibold">@g.Subject?.Name</td>
                            <td><span class="badge bg-light text-dark">@g.ExamType</span></td>
                            <td class="small text-muted">@g.ExamDate.ToString("MMM dd, yyyy")</td>
                            <td>@g.MarksObtained / @g.TotalMarks</td>
                            <td class="fw-bold">@g.Percentage%</td>
                            <td><span class="badge bg-@gc fs-6">@g.LetterGrade</span></td>
                            <td><span class="badge @(g.Percentage >= 40 ? "bg-success" : "bg-danger")">@(g.Percentage >= 40 ? "Pass" : "Fail")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else { <div class="card border-0 shadow-sm p-5 text-center text-muted"><i class="fas fa-star fa-3x mb-3 d-block opacity-25"></i><h5>No grades recorded yet</h5></div> }
