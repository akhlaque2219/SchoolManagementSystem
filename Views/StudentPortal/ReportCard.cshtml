@model IEnumerable<Grade>
@{ Layout = "~/Views/StudentPortal/_LayoutStudent.cshtml"; ViewData["Title"] = "Report Card"; var student = (Student)ViewBag.Student; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="fas fa-file-invoice me-2 text-success"></i>Report Card</h4>
    <button onclick="window.print()" class="btn btn-sm btn-outline-secondary"><i class="fas fa-print me-2"></i>Print</button>
</div>
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body text-center py-4">
        <h5 class="fw-bold">Greenwood Academy – Academic Report</h5>
        <div>@student.FullName &nbsp;|&nbsp; <code>@student.StudentId</code> &nbsp;|&nbsp; @(student.Class?.FullName ?? "—")</div>
    </div>
</div>
@if (Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark"><tr><th>Subject</th><th>Exam</th><th>Marks</th><th>Total</th><th>%</th><th>Grade</th><th>Result</th></tr></thead>
                <tbody>
                    @foreach (var g in Model)
                    {
                        var gc = g.LetterGrade switch {"A+"or"A"=>"success","B"=>"primary","C"=>"warning",_=>"danger"};
                        <tr><td class="fw-semibold">@g.Subject?.Name</td><td class="small">@g.ExamType</td><td>@g.MarksObtained</td><td>@g.TotalMarks</td><td>@g.Percentage%</td><td><span class="badge bg-@gc">@g.LetterGrade</span></td><td><span class="badge @(g.Percentage>=40?"bg-success":"bg-danger")">@(g.Percentage>=40?"Pass":"Fail")</span></td></tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr><td colspan="4" class="fw-bold">Overall</td><td class="fw-bold">@Math.Round(Model.Average(g=>(double)g.Percentage),1)%</td><td></td><td><span class="badge @(Model.Average(g=>(double)g.Percentage)>=40?"bg-success":"bg-danger")">@(Model.Average(g=>(double)g.Percentage)>=40?"PASS":"FAIL")</span></td></tr>
                </tfoot>
            </table>
        </div>
    </div>
}
else { <div class="card border-0 shadow-sm p-5 text-center text-muted"><h5>No grades available</h5></div> }
