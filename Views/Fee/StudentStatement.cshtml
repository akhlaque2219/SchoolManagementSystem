@model IEnumerable<FeePayment>
@{ ViewData["Title"] = "Student Fee Statement"; var student = (Student)ViewBag.Student; }

<div class="mt-4 mb-3 d-flex justify-content-between align-items-center">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Fee Management</a></li><li class="breadcrumb-item active">Statement</li></ol></nav>
        <h1 class="h3 fw-bold"><i class="fas fa-file-invoice-dollar me-2 text-success"></i>Fee Statement</h1>
    </div>
    <button onclick="window.print()" class="btn btn-outline-secondary"><i class="fas fa-print me-2"></i>Print</button>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar-circle-lg @(student.Gender=="Female"?"bg-pink":"bg-success") text-white">@student.FirstName[0]@student.LastName[0]</div>
                    <div>
                        <h5 class="fw-bold mb-1">@student.FullName</h5>
                        <div class="text-muted"><code>@student.StudentId</code> | @(student.Class?.FullName ?? "—")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 text-end">
                <div class="h5 fw-bold text-success">$@((decimal)ViewBag.TotalPaid) <small class="text-muted fs-6">paid</small></div>
                <div class="text-danger fw-semibold">$@((decimal)ViewBag.TotalPending) pending</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0">
                <thead class="table-light"><tr><th>Month</th><th>Fee Type</th><th>Amount</th><th>Paid</th><th>Balance</th><th>Method</th><th>Status</th><th>Receipt</th></tr></thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var sc = p.Status switch { FeeStatus.Paid => "success", FeeStatus.Overdue => "danger", FeeStatus.Partial => "warning", _ => "secondary" };
                        <tr>
                            <td>@p.Month</td>
                            <td class="small">@p.FeeStructure?.Name</td>
                            <td>$@(p.FeeStructure?.Amount.ToString("N0") ?? "—")</td>
                            <td class="fw-semibold text-success">$@p.AmountPaid.ToString("N0")</td>
                            <td class="@(p.Balance > 0 ? "text-danger" : "text-success")">$@p.Balance.ToString("N0")</td>
                            <td class="small">@p.PaymentMethod</td>
                            <td><span class="badge bg-@sc">@p.Status</span></td>
                            <td><a asp-action="Receipt" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info"><i class="fas fa-receipt"></i></a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else { <div class="p-5 text-center text-muted">No payment records found.</div> }
    </div>
</div>
