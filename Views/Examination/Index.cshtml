@model IEnumerable<Examination>
@{ ViewData["Title"] = "Examinations"; }

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <div><h1 class="h3 mb-0 fw-bold"><i class="fas fa-file-alt me-2 text-danger"></i>Examinations</h1><p class="text-muted mb-0">Manage exams, schedules & results</p></div>
    <a asp-action="Create" class="btn btn-danger"><i class="fas fa-plus me-2"></i>New Examination</a>
</div>

<!-- Filter bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">EXAM TYPE</label>
                <select name="examType" class="form-select">
                    <option value="">All Types</option>
                    @foreach (var t in new[]{"Mid Term","Final Term","Quiz","Assignment","Unit Test","Annual"})
                    { <option value="@t" selected="@(ViewBag.ExamType == t)">@t</option> }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">STATUS</label>
                <select name="status" class="form-select">
                    <option value="">All</option>
                    @foreach (var s in Enum.GetNames(typeof(ExamStatus)))
                    { <option value="@s" selected="@(ViewBag.StatusFilter == s)">@s</option> }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-danger me-2"><i class="fas fa-filter me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-times"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="row g-4">
    @foreach (var exam in Model)
    {
        var statusColor = exam.Status switch { ExamStatus.Scheduled => "primary", ExamStatus.Ongoing => "warning", ExamStatus.Completed => "success", _ => "secondary" };
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <span class="badge bg-danger-subtle text-danger mb-1">@exam.ExamType</span>
                            <h6 class="fw-bold mb-0">@exam.Title</h6>
                        </div>
                        <span class="badge bg-@statusColor">@exam.Status</span>
                    </div>
                    <div class="small text-muted mb-1"><i class="fas fa-calendar me-2"></i>@exam.StartDate.ToString("MMM dd") – @exam.EndDate.ToString("MMM dd, yyyy")</div>
                    <div class="small text-muted mb-1"><i class="fas fa-clock me-2"></i>@exam.Duration</div>
                    <div class="small text-muted mb-2"><i class="fas fa-school me-2"></i>@(exam.Class?.FullName ?? "All Classes")</div>
                    <div class="small text-muted mb-3"><i class="fas fa-list me-2"></i>@exam.Schedules.Count subject schedule(s)</div>
                    @if (exam.ResultDeclared)
                    { <span class="badge bg-success-subtle text-success"><i class="fas fa-check me-1"></i>Results Declared</span> }
                    else
                    { <span class="badge bg-warning-subtle text-warning"><i class="fas fa-clock me-1"></i>Results Pending</span> }
                </div>
                <div class="card-footer bg-white border-top border-light d-flex gap-2">
                    <a asp-action="Details" asp-route-id="@exam.Id" class="btn btn-sm btn-outline-info flex-fill"><i class="fas fa-eye me-1"></i>View</a>
                    <a asp-action="Edit" asp-route-id="@exam.Id" class="btn btn-sm btn-outline-primary flex-fill"><i class="fas fa-edit me-1"></i>Edit</a>
                    <a asp-action="Delete" asp-route-id="@exam.Id" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></a>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5 text-muted">
            <i class="fas fa-file-alt fa-3x mb-3 d-block opacity-25"></i>
            <h5>No examinations scheduled</h5>
            <a asp-action="Create" class="btn btn-danger mt-2">Schedule First Exam</a>
        </div>
    }
</div>
