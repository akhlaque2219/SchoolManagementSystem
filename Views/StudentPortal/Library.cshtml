@model IEnumerable<BookIssue>
@{ Layout = "~/Views/StudentPortal/_LayoutStudent.cshtml"; ViewData["Title"] = "My Books"; }
<h4 class="fw-bold mb-4"><i class="fas fa-book-open me-2 text-primary"></i>My Library Books</h4>
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark"><tr><th>Book</th><th>Author</th><th>Issued</th><th>Due Date</th><th>Returned</th><th>Fine</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        <tr class="@(i.IsOverdue ? "table-warning" : "")">
                            <td class="fw-semibold">@i.Book?.Title</td>
                            <td class="small text-muted">@i.Book?.Author</td>
                            <td class="small">@i.IssueDate.ToString("MMM dd")</td>
                            <td class="small @(i.IsOverdue ? "text-danger fw-bold" : "")">@i.DueDate.ToString("MMM dd, yyyy")</td>
                            <td class="small text-muted">@(i.ReturnDate?.ToString("MMM dd") ?? "—")</td>
                            <td>@(i.FineAmount > 0 ? $"${i.FineAmount} {(i.FinePaid ? "✅" : "⚠️")}" : "—")</td>
                            <td>
                                @switch (i.Status) {
                                    case IssueStatus.Issued:   <span class="badge bg-warning text-dark">Issued</span> break;
                                    case IssueStatus.Returned: <span class="badge bg-success">Returned</span> break;
                                    case IssueStatus.Overdue:  <span class="badge bg-danger">Overdue</span> break;
                                    default: <span class="badge bg-secondary">@i.Status</span> break;
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else { <p class="text-center text-muted py-5">No library records found.</p> }
    </div>
</div>
