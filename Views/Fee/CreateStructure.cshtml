@model FeeStructure
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Fee Structure" : "Add Fee Structure";
}
<div class="mt-4 mb-3">
    <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Fee Management</a></li><li class="breadcrumb-item active">@(isEdit?"Edit":"Add")</li></ol></nav>
    <h1 class="h3 fw-bold"><i class="fas fa-cog me-2 text-success"></i>@(isEdit?"Edit":"Add New") Fee Structure</h1>
</div>
<div class="card border-0 shadow-sm" style="max-width:650px">
    <div class="card-body p-4">
        <form asp-action="@(isEdit?"EditStructure":"CreateStructure")" method="post">
            @Html.AntiForgeryToken()
            @if (isEdit) { <input type="hidden" asp-for="Id" /> }
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Monthly Tuition Fee – Grade 9" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Category" class="form-label fw-semibold"></label>
                    <select asp-for="Category" asp-items="Html.GetEnumSelectList<FeeCategory>()" class="form-select"></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="ClassId" class="form-label fw-semibold">Class (optional)</label>
                    <select asp-for="ClassId" asp-items="ViewBag.Classes" class="form-select"><option value="">All Classes</option></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Amount" class="form-label fw-semibold"></label>
                    <div class="input-group"><span class="input-group-text">$</span><input asp-for="Amount" type="number" step="0.01" class="form-control" /></div>
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DueDayOfMonth" class="form-label fw-semibold"></label>
                    <input asp-for="DueDayOfMonth" type="number" class="form-control" min="1" max="28" />
                </div>
                <div class="col-md-4">
                    <label asp-for="AcademicYear" class="form-label fw-semibold"></label>
                    <input asp-for="AcademicYear" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Active</label>
                    </div>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-success px-4"><i class="fas fa-save me-2"></i>@(isEdit?"Update":"Create")</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
