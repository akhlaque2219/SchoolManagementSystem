<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Greenwood Academy</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="sb-nav-fixed">

    <!-- Top Navbar -->
    <nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark">
        <a class="navbar-brand ps-3 d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
            <i class="fas fa-graduation-cap text-warning"></i>
            <span class="fw-bold">Greenwood Academy</span>
        </a>
        <button class="btn btn-link btn-sm order-1 order-lg-0 me-4 me-lg-0" id="sidebarToggle">
            <i class="fas fa-bars text-white"></i>
        </button>
        <div class="d-none d-md-inline-block form-inline ms-auto me-0 me-md-3 my-2 my-md-0">
            <div class="text-white-50 small">Academic Year 2025</div>
        </div>
        <ul class="navbar-nav ms-auto ms-md-0 me-3 me-lg-4">
            @if (User.IsInRole("Admin"))
            {
                <li class="nav-item me-2">
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-sm btn-outline-danger text-white border-danger">
                        <i class="fas fa-user-cog me-1"></i>Admin
                    </a>
                </li>
            }
            <li class="nav-item me-2">
                <a asp-controller="Reports" asp-action="Index" class="nav-link text-white-50" title="Reports">
                    <i class="fas fa-chart-bar"></i>
                </a>
            </li>
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown">
                    <div style="width:30px;height:30px;border-radius:50%;background:#f5a623;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;color:#fff;">
                        @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "U")
                    </div>
                    <span class="text-white-50 small d-none d-lg-inline">@User.Identity?.Name</span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                    <li class="px-3 py-2 border-bottom">
                        <div class="fw-semibold small">@User.Identity?.Name</div>
                        @if (User.IsInRole("Admin"))       { <span class="badge bg-danger">Admin</span>   }
                        else if (User.IsInRole("Teacher")) { <span class="badge bg-primary">Teacher</span> }
                        else if (User.IsInRole("Staff"))   { <span class="badge bg-warning text-dark">Staff</span>  }
                    </li>
                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="fas fa-user me-2 text-muted"></i>Profile</a></li>
                    <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="fas fa-key me-2 text-muted"></i>Change Password</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger">
                                <i class="fas fa-sign-out-alt me-2"></i>Sign Out
                            </button>
                        </form>
                    </li>
                </ul>
            </li>
        </ul>
    </nav>

    <div id="layoutSidenav">
        <!-- Sidebar -->
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
                <div class="sb-sidenav-menu">
                    <div class="nav">
                        <div class="sb-sidenav-menu-heading">Core</div>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-tachometer-alt"></i></div>
                            Dashboard
                        </a>

                        <div class="sb-sidenav-menu-heading">Management</div>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Students" ? "active" : "")" asp-controller="Students" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-user-graduate"></i></div>
                            Students
                        </a>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Teachers" ? "active" : "")" asp-controller="Teachers" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-chalkboard-teacher"></i></div>
                            Teachers
                        </a>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Classes" ? "active" : "")" asp-controller="Classes" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-school"></i></div>
                            Classes
                        </a>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Subjects" ? "active" : "")" asp-controller="Subjects" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-book"></i></div>
                            Subjects
                        </a>

                        <div class="sb-sidenav-menu-heading">Academic</div>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Attendance" ? "active" : "")" asp-controller="Attendance" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-calendar-check"></i></div>
                            Attendance
                        </a>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Grades" ? "active" : "")" asp-controller="Grades" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-star"></i></div>
                            Grades & Results
                        </a>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Examination" ? "active" : "")" asp-controller="Examination" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-file-alt"></i></div>
                            Examinations
                        </a>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TimeTable" ? "active" : "")" asp-controller="TimeTable" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-calendar-alt"></i></div>
                            Time Table
                        </a>

                        <div class="sb-sidenav-menu-heading">Finance & Library</div>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Fee" ? "active" : "")" asp-controller="Fee" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-dollar-sign"></i></div>
                            Fee Management
                        </a>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Library" ? "active" : "")" asp-controller="Library" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-book-open"></i></div>
                            Library
                        </a>

                        <div class="sb-sidenav-menu-heading">Analytics</div>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-chart-bar"></i></div>
                            Reports
                        </a>

                        @if (User.IsInRole("Admin"))
                        {
                            <div class="sb-sidenav-menu-heading">Administration</div>
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                                <div class="sb-nav-link-icon"><i class="fas fa-user-cog"></i></div>
                                Admin Panel
                            </a>
                            <a class="nav-link" asp-controller="Admin" asp-action="Users">
                                <div class="sb-nav-link-icon"><i class="fas fa-users-cog"></i></div>
                                User Management
                            </a>
                            <a class="nav-link" asp-controller="Account" asp-action="Register">
                                <div class="sb-nav-link-icon"><i class="fas fa-user-plus"></i></div>
                                Register User
                            </a>
                        }
                    </div>
                </div>
                <div class="sb-sidenav-footer">
                    <div class="small">Signed in as:</div>
                    <span class="fw-semibold">@User.Identity?.Name</span>
                    @if (User.IsInRole("Admin"))       { <br><span class="badge bg-danger">Admin</span>   }
                    else if (User.IsInRole("Teacher")) { <br><span class="badge bg-primary">Teacher</span> }
                    else if (User.IsInRole("Staff"))   { <br><span class="badge bg-warning text-dark">Staff</span>  }
                </div>
            </nav>
        </div>

        <!-- Main Content -->
        <div id="layoutSidenav_content">
            <main>
                <div class="container-fluid px-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @RenderBody()
                </div>
            </main>
            <footer class="py-4 bg-light mt-auto">
                <div class="container-fluid px-4">
                    <div class="d-flex align-items-center justify-content-between small">
                        <div class="text-muted">&copy; 2025 Greenwood Academy SMS. All rights reserved.</div>
                        <div>Built with <i class="fas fa-heart text-danger"></i> using .NET Core MVC</div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- html -->
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
