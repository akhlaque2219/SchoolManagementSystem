@model IEnumerable<TimeTable>
@{
    ViewData["Title"] = "Teacher Schedule";
    var teacher = (Teacher)ViewBag.Teacher;
    var days = (DayOfWeekEnum[])ViewBag.Days;
}

<div class="mt-4 mb-3">
    <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Time Table</a></li><li class="breadcrumb-item active">Teacher Schedule</li></ol></nav>
    <h1 class="h3 fw-bold"><i class="fas fa-user-tie me-2 text-success"></i>Teacher Schedule</h1>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">SELECT TEACHER</label>
                <select name="teacherId" asp-items="ViewBag.Teachers" class="form-select" onchange="this.form.submit()"><option value="">-- Select Teacher --</option></select>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3">
            <div class="avatar-circle @(teacher.Gender=="Female"?"bg-pink":"bg-success") text-white">@teacher.FirstName[0]@teacher.LastName[0]</div>
            <div>
                <h5 class="fw-bold mb-1">@teacher.FullName</h5>
                <span class="text-muted small">@teacher.Specialization | @Model.Count() period(s) scheduled</span>
            </div>
        </div>
    </div>
</div>

@foreach (var day in days)
{
    var daySlots = Model.Where(t => t.Day == day).OrderBy(t => t.StartTime).ToList();
    if (daySlots.Any())
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="fw-semibold mb-0"><i class="fas fa-calendar-day me-2 text-primary"></i>@day</h6>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light"><tr><th>Time</th><th>Subject</th><th>Class</th><th>Room</th></tr></thead>
                    <tbody>
                        @foreach (var slot in daySlots)
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark">@slot.TimeRange</span></td>
                                <td class="fw-semibold">@(slot.Subject?.Name ?? "—")</td>
                                <td>@(slot.Class?.FullName ?? "—")</td>
                                <td class="text-muted small">@(slot.Room ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm p-5 text-center text-muted">
        <i class="fas fa-calendar-alt fa-3x mb-3 d-block opacity-25"></i>
        <h5>No schedule found for @teacher.FullName</h5>
    </div>
}
