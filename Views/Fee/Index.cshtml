@model IEnumerable<FeeStructure>
@{ ViewData["Title"] = "Fee Management"; }

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <div><h1 class="h3 mb-0 fw-bold"><i class="fas fa-dollar-sign me-2 text-success"></i>Fee Management</h1><p class="text-muted mb-0">Fee structures and payment tracking</p></div>
    <div class="d-flex gap-2">
        <a asp-action="Payments" class="btn btn-outline-success"><i class="fas fa-list me-2"></i>All Payments</a>
        <a asp-action="RecordPayment" class="btn btn-success"><i class="fas fa-plus me-2"></i>Record Payment</a>
        <a asp-action="CreateStructure" class="btn btn-outline-primary"><i class="fas fa-cog me-2"></i>Add Fee</a>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="h4 fw-bold text-success">$@((decimal)ViewBag.TotalCollected)</div>
            <div class="text-muted small">Total Collected</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="h4 fw-bold text-warning">@ViewBag.TotalPending</div>
            <div class="text-muted small">Pending Payments</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="h4 fw-bold text-danger">@ViewBag.OverdueCount</div>
            <div class="text-muted small">Overdue Payments</div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 py-3"><h6 class="fw-semibold mb-0"><i class="fas fa-list me-2 text-success"></i>Fee Structures</h6></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr><th>Fee Name</th><th>Category</th><th>Class</th><th>Amount</th><th>Due Day</th><th>Year</th><th>Status</th><th class="text-center">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var f in Model)
                    {
                        var catColor = f.Category switch { FeeCategory.Tuition => "primary", FeeCategory.Library => "info", FeeCategory.Sports => "success", FeeCategory.Exam => "danger", FeeCategory.Transport => "warning", _ => "secondary" };
                        <tr>
                            <td class="fw-semibold">@f.Name</td>
                            <td><span class="badge bg-@catColor">@f.Category</span></td>
                            <td>@(f.Class?.FullName ?? "<span class='text-muted'>All Classes</span>")</td>
                            <td class="fw-bold text-success">$@f.Amount.ToString("N0")</td>
                            <td>@f.DueDayOfMonth<sup>th</sup> of month</td>
                            <td>@f.AcademicYear</td>
                            <td>@if (f.IsActive) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-secondary">Inactive</span> }</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="EditStructure" asp-route-id="@f.Id" class="btn btn-outline-primary"><i class="fas fa-edit"></i></a>
                                    <form asp-action="DeleteStructure" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@f.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this fee structure?')"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any()) { <tr><td colspan="8" class="text-center py-4 text-muted">No fee structures defined yet</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>
