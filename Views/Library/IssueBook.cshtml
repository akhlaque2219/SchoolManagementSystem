@model BookIssue
@{ ViewData["Title"] = "Issue Book"; }
<div class="mt-4 mb-3">
    <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Library</a></li><li class="breadcrumb-item active">Issue Book</li></ol></nav>
    <h1 class="h3 fw-bold"><i class="fas fa-hand-holding-heart me-2 text-warning"></i>Issue Book to Student</h1>
</div>
<div class="card border-0 shadow-sm" style="max-width:650px">
    <div class="card-body p-4">
        <form asp-action="IssueBook" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="BookId" class="form-label fw-semibold">Book</label>
                    <select asp-for="BookId" asp-items="ViewBag.Books" class="form-select"><option value="">-- Select Available Book --</option></select>
                    <span asp-validation-for="BookId" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="StudentId" class="form-label fw-semibold">Student</label>
                    <select asp-for="StudentId" asp-items="ViewBag.Students" class="form-select"><option value="">-- Select Student --</option></select>
                    <span asp-validation-for="StudentId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="IssueDate" class="form-label fw-semibold"></label>
                    <input asp-for="IssueDate" type="date" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="DueDate" class="form-label fw-semibold"></label>
                    <input asp-for="DueDate" type="date" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Remarks" class="form-label fw-semibold"></label>
                    <textarea asp-for="Remarks" class="form-control" rows="2" placeholder="Optional..."></textarea>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-warning px-4"><i class="fas fa-check me-2"></i>Issue Book</button>
                <a asp-action="IssuedBooks" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
