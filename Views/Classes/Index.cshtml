@model IEnumerable<Class>
@{ ViewData["Title"] = "Classes"; }

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <div>
        <h1 class="h3 mb-0 fw-bold"><i class="fas fa-school me-2 text-warning"></i>Classes</h1>
        <p class="text-muted mb-0">Manage school classes and sections</p>
    </div>
    <a asp-action="Create" class="btn btn-warning"><i class="fas fa-plus me-2"></i>Add Class</a>
</div>

<div class="row g-4">
    @foreach (var cls in Model)
    {
        var pct = cls.MaxStudents > 0 ? (int)((double)cls.StudentCount / cls.MaxStudents * 100) : 0;
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="fw-bold mb-1">@cls.Name</h5>
                            <span class="badge bg-warning text-dark">Section @cls.Section</span>
                        </div>
                        <div class="text-muted small">@cls.AcademicYear</div>
                    </div>
                    <div class="mb-3">
                        <div class="small text-muted mb-1">Class Teacher</div>
                        <div class="fw-semibold">@(cls.Teacher?.FullName ?? "Unassigned")</div>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-muted">Students</span>
                            <span class="fw-semibold">@cls.StudentCount / @cls.MaxStudents</span>
                        </div>
                        <div class="progress" style="height:6px">
                            <div class="progress-bar @(pct > 80 ? "bg-danger" : "bg-warning")" style="width:@pct%"></div>
                        </div>
                    </div>
                    @if (cls.RoomNumber != null)
                    {
                        <div class="small text-muted"><i class="fas fa-door-open me-1"></i>Room @cls.RoomNumber</div>
                    }
                    <div class="small text-muted"><i class="fas fa-book me-1"></i>@cls.Subjects.Count subjects</div>
                </div>
                <div class="card-footer bg-white border-top border-light d-flex gap-2">
                    <a asp-action="Details" asp-route-id="@cls.Id" class="btn btn-sm btn-outline-info flex-fill"><i class="fas fa-eye me-1"></i>View</a>
                    <a asp-action="Edit" asp-route-id="@cls.Id" class="btn btn-sm btn-outline-primary flex-fill"><i class="fas fa-edit me-1"></i>Edit</a>
                    <a asp-action="Delete" asp-route-id="@cls.Id" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></a>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5 text-muted">
            <i class="fas fa-school fa-3x mb-3 opacity-25 d-block"></i>
            <h5>No classes created yet</h5>
            <a asp-action="Create" class="btn btn-warning mt-2">Create First Class</a>
        </div>
    }
</div>
