@model IEnumerable<Grade>
@{ ViewData["Title"] = "Grades & Results"; }

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <div><h1 class="h3 mb-0 fw-bold"><i class="fas fa-star me-2 text-warning"></i>Grades & Results</h1><p class="text-muted mb-0">Manage academic performance records</p></div>
    <a asp-action="Create" class="btn btn-warning"><i class="fas fa-plus me-2"></i>Record Grade</a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">SUBJECT</label>
                <select name="subjectId" asp-items="ViewBag.Subjects" class="form-select"><option value="">All Subjects</option></select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">EXAM TYPE</label>
                <select name="examType" class="form-select">
                    <option value="">All Types</option>
                    @foreach (var et in Enum.GetNames(typeof(ExamType))) { <option value="@et" selected="@(ViewBag.SelectedExamType == et)">@et</option> }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-warning me-2"><i class="fas fa-filter me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-times"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr><th>Student</th><th>Subject</th><th>Exam Type</th><th>Marks</th><th>%</th><th>Grade</th><th>Status</th><th>Date</th><th class="text-center">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var g in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@g.Student?.FullName</div>
                                <small class="text-muted">@g.Student?.Class?.FullName</small>
                            </td>
                            <td>@g.Subject?.Name</td>
                            <td><span class="badge bg-light text-dark">@g.ExamType</span></td>
                            <td><strong>@g.MarksObtained</strong><span class="text-muted">/@g.TotalMarks</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:6px;min-width:60px">
                                        <div class="progress-bar @(g.Percentage >= 80 ? "bg-success" : g.Percentage >= 50 ? "bg-warning" : "bg-danger")" style="width:@g.Percentage%"></div>
                                    </div>
                                    <span class="small">@g.Percentage%</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge @(g.LetterGrade.StartsWith("A") ? "bg-success" : g.LetterGrade == "B" ? "bg-primary" : g.LetterGrade == "C" ? "bg-info" : g.LetterGrade == "D" ? "bg-warning" : "bg-danger") fs-6">
                                    @g.LetterGrade
                                </span>
                            </td>
                            <td>
                                @if (g.IsPassed) { <span class="badge bg-success-subtle text-success border border-success">Passed</span> }
                                else { <span class="badge bg-danger-subtle text-danger border border-danger">Failed</span> }
                            </td>
                            <td class="text-muted small">@g.ExamDate.ToString("MMM dd, yyyy")</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@g.Id" class="btn btn-outline-primary"><i class="fas fa-edit"></i></a>
                                    <a asp-action="Delete" asp-route-id="@g.Id" class="btn btn-outline-danger"><i class="fas fa-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any()) {
                        <tr><td colspan="9" class="text-center py-5 text-muted"><i class="fas fa-star fa-2x mb-2 d-block opacity-25"></i>No grades recorded yet</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.Any()) { <div class="card-footer bg-white"><small class="text-muted">@Model.Count() records | Avg: @Model.Average(g => g.Percentage).ToString("F1")%</small></div> }
</div>
