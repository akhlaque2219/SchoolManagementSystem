@model Class
@{ ViewData["Title"] = "Class Details"; }

<div class="mt-4 mb-3">
    <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li><li class="breadcrumb-item"><a asp-action="Index">Classes</a></li><li class="breadcrumb-item active">@Model.FullName</li></ol></nav>
    <div class="d-flex justify-content-between">
        <h1 class="h3 fw-bold"><i class="fas fa-school me-2 text-warning"></i>@Model.Name - Section @Model.Section</h1>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit me-2"></i>Edit</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h6 class="fw-semibold text-warning mb-3">Class Info</h6>
                <div class="small mb-2"><span class="text-muted">Teacher:</span> <strong>@(Model.Teacher?.FullName ?? "Unassigned")</strong></div>
                <div class="small mb-2"><span class="text-muted">Academic Year:</span> @Model.AcademicYear</div>
                <div class="small mb-2"><span class="text-muted">Room:</span> @(Model.RoomNumber ?? "N/A")</div>
                <div class="small mb-2"><span class="text-muted">Capacity:</span> @Model.StudentCount / @Model.MaxStudents students</div>
                <div class="progress mt-2" style="height:8px">
                    <div class="progress-bar bg-warning" style="width:@(Model.MaxStudents > 0 ? (int)((double)Model.StudentCount/Model.MaxStudents*100) : 0)%"></div>
                </div>
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0"><h6 class="fw-semibold text-info mb-0">Subjects (@Model.Subjects.Count)</h6></div>
            <div class="list-group list-group-flush">
                @foreach (var s in Model.Subjects)
                {
                    <div class="list-group-item d-flex justify-content-between">
                        <div><div class="fw-semibold small">@s.Name</div><code class="text-muted" style="font-size:11px">@s.Code</code></div>
                        <span class="badge bg-light text-dark align-self-center">@s.CreditHours cr</span>
                    </div>
                }
                @if (!Model.Subjects.Any()) { <div class="list-group-item text-muted small">No subjects assigned</div> }
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 d-flex justify-content-between py-3">
                <h6 class="fw-semibold mb-0"><i class="fas fa-users me-2 text-primary"></i>Students (@Model.Students.Count)</h6>
                <a asp-controller="Attendance" asp-action="TakeAttendance" asp-route-classId="@Model.Id" class="btn btn-sm btn-outline-info">
                    <i class="fas fa-calendar-check me-1"></i>Take Attendance
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.Students.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th>Student</th><th>ID</th><th>Gender</th><th>Actions</th></tr></thead>
                        <tbody>
                            @foreach (var s in Model.Students.OrderBy(x => x.LastName))
                            {
                                <tr>
                                    <td class="fw-semibold">@s.FullName</td>
                                    <td><code>@s.StudentId</code></td>
                                    <td>@s.Gender</td>
                                    <td>
                                        <a asp-controller="Students" asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-info"><i class="fas fa-eye"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else { <div class="p-4 text-center text-muted">No students enrolled yet</div> }
            </div>
        </div>
    </div>
</div>
