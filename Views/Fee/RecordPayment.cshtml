@model FeePayment
@{ ViewData["Title"] = "Record Payment"; }
<div class="mt-4 mb-3">
    <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Fee Management</a></li><li class="breadcrumb-item"><a asp-action="Payments">Payments</a></li><li class="breadcrumb-item active">Record</li></ol></nav>
    <h1 class="h3 fw-bold"><i class="fas fa-receipt me-2 text-success"></i>Record Fee Payment</h1>
</div>
<div class="card border-0 shadow-sm" style="max-width:700px">
    <div class="card-body p-4">
        <form asp-action="RecordPayment" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="StudentId" class="form-label fw-semibold">Student</label>
                    <select asp-for="StudentId" asp-items="ViewBag.Students" class="form-select"><option value="">-- Select Student --</option></select>
                    <span asp-validation-for="StudentId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FeeStructureId" class="form-label fw-semibold">Fee Type</label>
                    <select asp-for="FeeStructureId" asp-items="ViewBag.FeeStructures" class="form-select"><option value="">-- Select Fee --</option></select>
                    <span asp-validation-for="FeeStructureId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="AmountPaid" class="form-label fw-semibold"></label>
                    <div class="input-group"><span class="input-group-text">$</span><input asp-for="AmountPaid" type="number" step="0.01" class="form-control" /></div>
                    <span asp-validation-for="AmountPaid" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="PaymentDate" class="form-label fw-semibold"></label>
                    <input asp-for="PaymentDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="DueDate" class="form-label fw-semibold"></label>
                    <input asp-for="DueDate" type="date" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Month" class="form-label fw-semibold"></label>
                    <input asp-for="Month" class="form-control" placeholder="e.g. March 2025" />
                </div>
                <div class="col-md-6">
                    <label asp-for="PaymentMethod" class="form-label fw-semibold"></label>
                    <select asp-for="PaymentMethod" class="form-select">
                        @foreach (var m in new[]{"Cash","Online","Cheque","Bank Transfer","Card"}) { <option value="@m">@m</option> }
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="ReceiptNo" class="form-label fw-semibold"></label>
                    <input asp-for="ReceiptNo" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="TransactionId" class="form-label fw-semibold"></label>
                    <input asp-for="TransactionId" class="form-control" placeholder="For online payments" />
                </div>
                <div class="col-12">
                    <label asp-for="Remarks" class="form-label fw-semibold"></label>
                    <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-success px-4"><i class="fas fa-save me-2"></i>Save Payment</button>
                <a asp-action="Payments" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
