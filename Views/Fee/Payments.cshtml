@model IEnumerable<FeePayment>
@{ ViewData["Title"] = "Fee Payments"; }

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <div><h1 class="h3 mb-0 fw-bold"><i class="fas fa-receipt me-2 text-success"></i>Payment Records</h1></div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Fee Structures</a>
        <a asp-action="RecordPayment" class="btn btn-success"><i class="fas fa-plus me-2"></i>Record Payment</a>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">STUDENT</label>
                <select name="studentId" asp-items="ViewBag.Students" class="form-select"><option value="">All Students</option></select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">STATUS</label>
                <select name="status" class="form-select">
                    <option value="">All</option>
                    @foreach (var s in Enum.GetNames(typeof(FeeStatus))) { <option value="@s" selected="@(ViewBag.StatusFilter==s)">@s</option> }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-success me-2"><i class="fas fa-filter me-1"></i>Filter</button>
                <a asp-action="Payments" class="btn btn-outline-secondary"><i class="fas fa-times"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr><th>Student</th><th>Fee Type</th><th>Month</th><th>Amount</th><th>Paid</th><th>Balance</th><th>Status</th><th>Method</th><th>Receipt</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var statusColor = p.Status switch { FeeStatus.Paid => "success", FeeStatus.Overdue => "danger", FeeStatus.Partial => "warning", FeeStatus.Waived => "info", _ => "secondary" };
                        <tr>
                            <td>
                                <div class="fw-semibold">@p.Student?.FullName</div>
                                <small class="text-muted">@p.Student?.Class?.FullName</small>
                            </td>
                            <td class="small">@p.FeeStructure?.Name</td>
                            <td class="small text-muted">@p.Month</td>
                            <td>$@(p.FeeStructure?.Amount.ToString("N0") ?? "—")</td>
                            <td class="fw-semibold text-success">$@p.AmountPaid.ToString("N0")</td>
                            <td class="@(p.Balance > 0 ? "text-danger fw-semibold" : "text-success")">$@p.Balance.ToString("N0")</td>
                            <td><span class="badge bg-@statusColor">@p.Status</span></td>
                            <td class="small">@p.PaymentMethod</td>
                            <td><code class="small">@p.ReceiptNo</code></td>
                            <td>
                                <a asp-action="Receipt" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info"><i class="fas fa-print"></i></a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any()) { <tr><td colspan="10" class="text-center py-4 text-muted">No payments found</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.Any())
    {
        <div class="card-footer bg-white">
            <small class="text-muted">@Model.Count() records | Total Collected: <strong class="text-success">$@Model.Where(p => p.Status == FeeStatus.Paid).Sum(p => p.AmountPaid).ToString("N0")</strong></small>
        </div>
    }
</div>
