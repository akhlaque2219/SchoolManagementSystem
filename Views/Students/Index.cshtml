@model IEnumerable<Student>
@{
    ViewData["Title"] = "Students";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <div>
        <h1 class="h3 mb-0 fw-bold"><i class="fas fa-user-graduate me-2 text-primary"></i>Students</h1>
        <p class="text-muted mb-0">Manage all enrolled students</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-user-plus me-2"></i>Add Student</a>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted fw-semibold">SEARCH</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Name, ID, Email...">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted fw-semibold">CLASS</label>
                <select name="classId" asp-items="ViewBag.Classes" class="form-select">
                    <option value="">All Classes</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted fw-semibold">STATUS</label>
                <select name="isActive" class="form-select">
                    <option value="">All</option>
                    <option value="true" selected="@(ViewBag.IsActive == true)">Active</option>
                    <option value="false" selected="@(ViewBag.IsActive == false)">Inactive</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary me-2"><i class="fas fa-filter me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-times me-1"></i>Clear</a>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Student</th>
                            <th>ID</th>
                            <th>Class</th>
                            <th>Gender</th>
                            <th>Age</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle @(s.Gender == "Female" ? "bg-pink" : "bg-primary") text-white">
                                            @s.FirstName[0]@s.LastName[0]
                                        </div>
                                        <div>
                                            <div class="fw-semibold">@s.FullName</div>
                                            <small class="text-muted">@s.Phone</small>
                                        </div>
                                    </div>
                                </td>
                                <td><code>@s.StudentId</code></td>
                                <td>@(s.Class?.FullName ?? "<span class='text-muted'>Unassigned</span>")</td>
                                <td>
                                    <span class="badge @(s.Gender == "Female" ? "bg-pink-light text-pink" : "bg-blue-light text-primary")">
                                        <i class="fas @(s.Gender == "Female" ? "fa-venus" : "fa-mars") me-1"></i>@s.Gender
                                    </span>
                                </td>
                                <td>@s.Age yrs</td>
                                <td class="text-muted small">@s.Email</td>
                                <td>
                                    @if (s.IsActive)
                                    { <span class="badge bg-success"><i class="fas fa-circle me-1" style="font-size:8px"></i>Active</span> }
                                    else
                                    { <span class="badge bg-secondary">Inactive</span> }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-outline-info" title="View"><i class="fas fa-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-outline-primary" title="Edit"><i class="fas fa-edit"></i></a>
                                        <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-outline-danger" title="Delete"><i class="fas fa-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-user-graduate fa-3x mb-3 opacity-25 d-block"></i>
                <h5>No students found</h5>
                <p>Try adjusting your filters or <a asp-action="Create">add a new student</a>.</p>
            </div>
        }
    </div>
    @if (Model.Any())
    {
        <div class="card-footer bg-white border-top-0">
            <small class="text-muted">Showing @Model.Count() student(s)</small>
        </div>
    }
</div>
