@model GradeReportViewModel
@{ ViewData["Title"] = "Grades Report"; }

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h1 class="h3 fw-bold mb-0"><i class="fas fa-star me-2 text-warning"></i>Grades Report</h1>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm"><i class="fas fa-print me-2"></i>Print</button>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm"><i class="fas fa-arrow-left me-2"></i>Reports</a>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">CLASS</label>
                <select name="classId" asp-items="ViewBag.Classes" class="form-select"><option value="">All Classes</option></select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">SUBJECT</label>
                <select name="subjectId" asp-items="ViewBag.Subjects" class="form-select"><option value="">All Subjects</option></select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">EXAM TYPE</label>
                <select name="examType" class="form-select">
                    <option value="">All Types</option>
                    @foreach (var t in (string[])ViewBag.ExamTypes) { <option value="@t" selected="@(ViewBag.ExamFilter==t)">@t</option> }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-warning w-100"><i class="fas fa-search me-1"></i>Generate</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-3"><div class="h3 fw-bold text-warning">@Model.ClassAverage%</div><div class="small text-muted">Class Average</div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-3"><div class="h3 fw-bold text-success">@Model.PassCount</div><div class="small text-muted">Passed</div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-3"><div class="h3 fw-bold text-danger">@Model.FailCount</div><div class="small text-muted">Failed</div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-3"><div class="h3 fw-bold text-primary">@Model.TotalStudents</div><div class="small text-muted">Students</div></div></div>
</div>

@if (Model.Rows.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr><th>Student</th><th>ID</th><th>Class</th><th>Subject</th><th>Type</th><th>Marks</th><th>%</th><th>Grade</th><th>Result</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            var gc = r.Grade switch { "A+" or "A" => "success", "B" => "primary", "C" => "warning", _ => "danger" };
                            <tr class="@(!r.Passed ? "table-danger bg-opacity-25" : "")">
                                <td class="fw-semibold">@r.StudentName</td>
                                <td><code class="small">@r.StudentId</code></td>
                                <td class="small text-muted">@r.ClassName</td>
                                <td>@r.SubjectName</td>
                                <td><span class="badge bg-light text-dark">@r.ExamType</span></td>
                                <td>@r.Marks/@r.Total</td>
                                <td class="fw-bold">@r.Percentage%</td>
                                <td><span class="badge bg-@gc">@r.Grade</span></td>
                                <td><span class="badge @(r.Passed ? "bg-success" : "bg-danger")">@(r.Passed ? "Pass" : "Fail")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white"><small class="text-muted">@Model.Rows.Count records | Pass rate: @(Model.TotalStudents > 0 ? Math.Round((double)Model.PassCount / Model.Rows.Count * 100, 1) : 0)%</small></div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm p-5 text-center text-muted">
        <i class="fas fa-star fa-3x mb-3 d-block opacity-25"></i><h5>No grade data for selected filters</h5>
    </div>
}
