@model IEnumerable<TimeTable>
@{
    ViewData["Title"] = "Time Table";
    var days = (DayOfWeekEnum[])ViewBag.Days;
    int selectedClassId = (int)(ViewBag.SelectedClassId ?? 0);
    var slotsByDay = Model.GroupBy(t => t.Day).ToDictionary(g => g.Key, g => g.OrderBy(t => t.PeriodNo).ToList());
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <div><h1 class="h3 mb-0 fw-bold"><i class="fas fa-calendar-alt me-2 text-indigo"></i>Time Table</h1><p class="text-muted mb-0">Weekly class schedule</p></div>
    <div class="d-flex gap-2">
        <a asp-action="TeacherSchedule" asp-route-teacherId="1" class="btn btn-outline-secondary"><i class="fas fa-user-tie me-2"></i>Teacher View</a>
        @if (selectedClassId > 0)
        {
            <a asp-action="Create" asp-route-classId="@selectedClassId" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Add Period</a>
        }
    </div>
</div>

<!-- Class Selector -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">SELECT CLASS</label>
                <select name="classId" asp-items="ViewBag.Classes" class="form-select" onchange="this.form.submit()"><option value="">-- Select a Class --</option></select>
            </div>
        </form>
    </div>
</div>

@if (selectedClassId > 0)
{
    <!-- Timetable Grid -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <h6 class="fw-semibold mb-0"><i class="fas fa-table me-2 text-primary"></i>Weekly Schedule</h6>
            <a asp-action="Create" asp-route-classId="@selectedClassId" class="btn btn-sm btn-primary"><i class="fas fa-plus me-1"></i>Add Period</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered mb-0 timetable-grid">
                    <thead>
                        <tr class="table-dark">
                            @foreach (var day in days)
                            {
                                <th class="text-center" style="min-width:130px">@day</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int maxPeriods = slotsByDay.Any() ? slotsByDay.Max(d => d.Value.Count) : 0;
                            if (maxPeriods == 0) maxPeriods = 1;
                        }
                        @for (int p = 0; p < maxPeriods; p++)
                        {
                            <tr>
                                @foreach (var day in days)
                                {
                                    var slot = slotsByDay.ContainsKey(day) && slotsByDay[day].Count > p ? slotsByDay[day][p] : null;
                                    <td class="align-top p-2" style="min-height:80px">
                                        @if (slot != null)
                                        {
                                            var subColors = new[] { "primary", "success", "warning", "danger", "info", "secondary" };
                                            var color = subColors[(slot.SubjectId ?? 0) % subColors.Length];
                                            <div class="timetable-slot border border-@color rounded p-2">
                                                <div class="small fw-bold text-@color">@(slot.Subject?.Name ?? "Free")</div>
                                                <div class="text-muted" style="font-size:11px"><i class="fas fa-clock me-1"></i>@slot.TimeRange</div>
                                                <div class="text-muted" style="font-size:11px"><i class="fas fa-user me-1"></i>@(slot.Teacher?.FullName?.Split(' ')[0] ?? "—")</div>
                                                @if (!string.IsNullOrEmpty(slot.Room)) { <div class="text-muted" style="font-size:11px"><i class="fas fa-door-open me-1"></i>@slot.Room</div> }
                                                <div class="d-flex gap-1 mt-1">
                                                    <a asp-action="Edit" asp-route-id="@slot.Id" class="btn btn-xs btn-outline-primary p-0 px-1" style="font-size:10px"><i class="fas fa-edit"></i></a>
                                                    <form asp-action="Delete" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@slot.Id" />
                                                        <button type="submit" class="btn btn-xs btn-outline-danger p-0 px-1" style="font-size:10px" onclick="return confirm('Remove this period?')"><i class="fas fa-times"></i></button>
                                                    </form>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="timetable-empty text-muted text-center py-3" style="font-size:11px; opacity:0.4;">
                                                <i class="fas fa-plus d-block mb-1"></i>Free
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- List View -->
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-header bg-white border-0 py-3"><h6 class="fw-semibold mb-0"><i class="fas fa-list me-2"></i>All Periods (List View)</h6></div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light"><tr><th>Day</th><th>Period</th><th>Time</th><th>Subject</th><th>Teacher</th><th>Room</th><th class="text-center">Actions</th></tr></thead>
                <tbody>
                    @foreach (var slot in Model.OrderBy(t => t.Day).ThenBy(t => t.PeriodNo))
                    {
                        <tr>
                            <td class="fw-semibold">@slot.Day</td>
                            <td><span class="badge bg-primary">P@slot.PeriodNo</span></td>
                            <td><span class="badge bg-light text-dark">@slot.TimeRange</span></td>
                            <td>@(slot.Subject?.Name ?? "—")</td>
                            <td class="small text-muted">@(slot.Teacher?.FullName ?? "—")</td>
                            <td class="small">@(slot.Room ?? "—")</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@slot.Id" class="btn btn-outline-primary"><i class="fas fa-edit"></i></a>
                                    <form asp-action="Delete" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@slot.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove?')"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any()) { <tr><td colspan="7" class="text-center py-4 text-muted">No periods scheduled</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm p-5 text-center text-muted">
        <i class="fas fa-calendar-alt fa-3x mb-3 d-block opacity-25"></i>
        <h5>Select a class to view timetable</h5>
    </div>
}

<style>
.timetable-grid td { vertical-align: top; }
.timetable-slot { background: #fafafa; transition: all .2s; }
.timetable-slot:hover { background: #f0f4ff; }
.text-indigo { color: #6610f2 !important; }
</style>
