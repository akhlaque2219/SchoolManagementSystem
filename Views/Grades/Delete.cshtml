@model Grade
@{ ViewData["Title"] = "Delete Grade"; }
<div class="mt-4"><h1 class="h3 fw-bold text-danger"><i class="fas fa-trash me-2"></i>Delete Grade</h1></div>
<div class="card border-0 shadow-sm mt-3" style="max-width:500px">
    <div class="card-body p-4">
        <div class="alert alert-danger">Delete this grade record?</div>
        <p><strong>@Model.Student?.FullName</strong> — @Model.Subject?.Name (@Model.ExamType)<br><small class="text-muted">@Model.MarksObtained/@Model.TotalMarks (@Model.Percentage%)</small></p>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger me-2">Yes, Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
