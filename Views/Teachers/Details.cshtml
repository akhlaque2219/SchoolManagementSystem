@model Teacher
@{ ViewData["Title"] = "Teacher Details"; }

<div class="mt-4 mb-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Teachers</a></li>
            <li class="breadcrumb-item active">@Model.FullName</li>
        </ol>
    </nav>
</div>
<div class="row g-4">
    <div class="col-xl-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <div class="avatar-circle-lg @(Model.Gender == "Female" ? "bg-pink" : "bg-success") text-white mx-auto mb-3">@Model.FirstName[0]@Model.LastName[0]</div>
            <h4 class="fw-bold mb-1">@Model.FullName</h4>
            <p class="text-muted small mb-1"><code>@Model.TeacherId</code></p>
            <p class="text-success mb-2">@Model.Specialization</p>
            @if (Model.IsActive) { <span class="badge bg-success mb-3">Active</span> } else { <span class="badge bg-secondary mb-3">Inactive</span> }
            <div class="text-start border rounded p-3">
                <div class="small mb-1"><span class="text-muted">Email:</span> @Model.Email</div>
                <div class="small mb-1"><span class="text-muted">Phone:</span> @(Model.Phone ?? "N/A")</div>
                <div class="small mb-1"><span class="text-muted">Qualification:</span> @Model.Qualification</div>
                <div class="small mb-1"><span class="text-muted">Joined:</span> @Model.JoiningDate.ToString("MMM dd, yyyy")</div>
                @if (Model.Salary.HasValue) { <div class="small"><span class="text-muted">Salary:</span> $@Model.Salary.Value.ToString("N0")</div> }
            </div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success mt-3"><i class="fas fa-edit me-2"></i>Edit</a>
        </div>
    </div>
    <div class="col-xl-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 py-3"><h5 class="mb-0 fw-semibold"><i class="fas fa-school me-2 text-warning"></i>Classes Assigned</h5></div>
            <div class="card-body p-0">
                @if (Model.Classes.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th>Class</th><th>Section</th><th>Students</th><th>Room</th></tr></thead>
                        <tbody>
                            @foreach (var c in Model.Classes)
                            {
                                <tr>
                                    <td class="fw-semibold">@c.Name</td>
                                    <td>@c.Section</td>
                                    <td><span class="badge bg-primary">@c.Students.Count</span></td>
                                    <td>@(c.RoomNumber ?? "N/A")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else { <div class="p-4 text-center text-muted">No classes assigned</div> }
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3"><h5 class="mb-0 fw-semibold"><i class="fas fa-book me-2 text-info"></i>Subjects Teaching</h5></div>
            <div class="card-body p-0">
                @if (Model.Subjects.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th>Subject</th><th>Code</th><th>Credits</th><th>Total Marks</th></tr></thead>
                        <tbody>
                            @foreach (var s in Model.Subjects)
                            {
                                <tr>
                                    <td class="fw-semibold">@s.Name</td>
                                    <td><code>@s.Code</code></td>
                                    <td>@s.CreditHours</td>
                                    <td>@s.TotalMarks</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else { <div class="p-4 text-center text-muted">No subjects assigned</div> }
            </div>
        </div>
    </div>
</div>
