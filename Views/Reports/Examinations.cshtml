@model IEnumerable<Examination>
@{ ViewData["Title"] = "Examination Report"; }
<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h1 class="h3 fw-bold mb-0"><i class="fas fa-file-alt me-2 text-secondary"></i>Examination Report</h1>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm"><i class="fas fa-print me-2"></i>Print</button>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm"><i class="fas fa-arrow-left me-2"></i>Reports</a>
    </div>
</div>
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-3"><div class="h3 fw-bold text-secondary">@Model.Count()</div><div class="small text-muted">Total Exams</div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-3"><div class="h3 fw-bold text-primary">@Model.Count(e => e.Status == ExamStatus.Scheduled)</div><div class="small text-muted">Scheduled</div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-3"><div class="h3 fw-bold text-success">@Model.Count(e => e.Status == ExamStatus.Completed)</div><div class="small text-muted">Completed</div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-3"><div class="h3 fw-bold text-success">@Model.Count(e => e.ResultDeclared)</div><div class="small text-muted">Results Out</div></div></div>
</div>
<div class="card border-0 shadow-sm">
    <div class="card-body p-0"><table class="table table-hover align-middle mb-0">
        <thead class="table-dark"><tr><th>Title</th><th>Type</th><th>Class</th><th>Start</th><th>End</th><th>Subjects</th><th>Status</th><th>Results</th></tr></thead>
        <tbody>
            @foreach (var e in Model)
            {
                var sc = e.Status switch { ExamStatus.Scheduled=>"primary",ExamStatus.Ongoing=>"warning",ExamStatus.Completed=>"success",_=>"secondary"};
                <tr><td class="fw-semibold">@e.Title</td><td><span class="badge bg-light text-dark">@e.ExamType</span></td><td class="small">@(e.Class?.FullName??"All")</td><td class="small">@e.StartDate.ToString("MMM dd")</td><td class="small">@e.EndDate.ToString("MMM dd, yyyy")</td><td class="text-center">@e.Schedules.Count</td><td><span class="badge bg-@sc">@e.Status</span></td><td>@(e.ResultDeclared ? "<span class='badge bg-success'>Declared</span>" : "<span class='badge bg-warning text-dark'>Pending</span>")</td></tr>
            }
        </tbody>
    </table></div>
</div>
