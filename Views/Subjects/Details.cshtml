@model Subject
@{ ViewData["Title"] = "Subject Details"; }
<div class="mt-4 mb-3">
    <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li><li class="breadcrumb-item"><a asp-action="Index">Subjects</a></li><li class="breadcrumb-item active">@Model.Name</li></ol></nav>
    <div class="d-flex justify-content-between"><h1 class="h3 fw-bold"><i class="fas fa-book me-2 text-info"></i>@Model.Name</h1><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-info text-white"><i class="fas fa-edit me-2"></i>Edit</a></div>
</div>
<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="fw-semibold text-info mb-3">Subject Info</h6>
                <div class="small mb-2"><span class="text-muted">Code:</span> <code>@Model.Code</code></div>
                <div class="small mb-2"><span class="text-muted">Class:</span> @(Model.Class?.FullName ?? "N/A")</div>
                <div class="small mb-2"><span class="text-muted">Teacher:</span> @(Model.Teacher?.FullName ?? "Unassigned")</div>
                <div class="small mb-2"><span class="text-muted">Credit Hours:</span> @Model.CreditHours</div>
                <div class="small mb-2"><span class="text-muted">Total Marks:</span> @Model.TotalMarks</div>
                <div class="small"><span class="text-muted">Pass Marks:</span> @Model.PassMarks</div>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0"><h6 class="fw-semibold mb-0">Recent Grades</h6></div>
            <div class="card-body p-0">
                @if (Model.Grades.Any()) {
                    <table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th>Student</th><th>Exam</th><th>Marks</th><th>%</th><th>Grade</th></tr></thead>
                        <tbody>
                            @foreach (var g in Model.Grades.OrderByDescending(x => x.ExamDate).Take(10)) {
                                <tr>
                                    <td>@g.Student?.FullName</td>
                                    <td><span class="badge bg-light text-dark">@g.ExamType</span></td>
                                    <td>@g.MarksObtained/@g.TotalMarks</td>
                                    <td>@g.Percentage%</td>
                                    <td><span class="badge bg-success">@g.LetterGrade</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                } else { <div class="p-4 text-center text-muted">No grades recorded</div> }
            </div>
        </div>
    </div>
</div>
