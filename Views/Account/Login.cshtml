@model LoginViewModel
@{ Layout = null; ViewData["Title"] = "Sign In"; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In – Greenwood Academy</title>
    @* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" /> *@
    <script src="~/js/jquery.min.js"></script>
    
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/all.min.css" rel="stylesheet" />
    
    <style>
        body { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); min-height: 100vh; display: flex; align-items: center; font-family: 'Segoe UI', sans-serif; }
        .login-card { background: #fff; border-radius: 20px; box-shadow: 0 25px 60px rgba(0,0,0,.35); overflow: hidden; max-width: 900px; width: 100%; }
        .login-brand { background: linear-gradient(160deg, #f5a623 0%, #e8850a 100%); padding: 3rem 2.5rem; display: flex; flex-direction: column; justify-content: center; }
        .login-brand .logo-icon { width: 70px; height: 70px; background: rgba(255,255,255,.2); border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 2rem; color: #fff; margin-bottom: 1.5rem; }
        .login-brand h2 { color: #fff; font-weight: 700; margin-bottom: .5rem; }
        .login-brand p  { color: rgba(255,255,255,.85); font-size: .95rem; }
        .portal-badge { display: inline-flex; align-items: center; gap: .4rem; background: rgba(255,255,255,.2); color: #fff; border-radius: 30px; padding: .3rem .9rem; font-size: .8rem; margin-bottom: 2rem; }
        .login-form-side { padding: 3rem 2.5rem; }
        .form-floating label { color: #888; }
        .btn-login { background: linear-gradient(135deg, #f5a623, #e8850a); border: none; border-radius: 10px; padding: .75rem; font-weight: 600; font-size: 1rem; letter-spacing: .02em; transition: all .2s; }
        .btn-login:hover { transform: translateY(-1px); box-shadow: 0 8px 20px rgba(245,166,35,.4); }
        .portal-tabs .nav-link { border-radius: 8px; font-size: .85rem; color: #666; padding: .4rem 1rem; }
        .portal-tabs .nav-link.active { background: #0f3460; color: #fff; }
        .divider { display: flex; align-items: center; gap: 1rem; color: #ccc; font-size: .8rem; margin: 1rem 0; }
        .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: #eee; }
        .quick-fill { font-size: .78rem; }
    </style>
</head>
<body>
<div class="container py-4">
    <div class="login-card mx-auto">
        <div class="row g-0">
            <!-- Brand Side -->
            <div class="col-lg-5 login-brand">
                <div class="logo-icon"><i class="fas fa-graduation-cap"></i></div>
                <div class="portal-badge"><i class="fas fa-shield-alt"></i> Secure Portal</div>
                <h2>Greenwood Academy</h2>
                <p>School Management System — sign in to access your personalised dashboard.</p>
                <hr style="border-color:rgba(255,255,255,.3); margin: 1.5rem 0;">
                <div class="quick-fill text-white-50 mb-2 fw-semibold">QUICK LOGIN (DEMO)</div>
                <div class="d-flex flex-column gap-2">
                    <button onclick="fill('admin@school.edu','Admin@123456')"    class="btn btn-sm btn-outline-light rounded-pill"><i class="fas fa-user-cog me-2"></i>Admin</button>
                    <button onclick="fill('john.smith@school.edu','Teacher@123456')" class="btn btn-sm btn-outline-light rounded-pill"><i class="fas fa-chalkboard-teacher me-2"></i>Teacher</button>
                    <button onclick="fill('staff@school.edu','Staff@123456')"    class="btn btn-sm btn-outline-light rounded-pill"><i class="fas fa-user-tie me-2"></i>Staff</button>
                    <button onclick="fill('alice@student.edu','Student@123456')" class="btn btn-sm btn-outline-light rounded-pill"><i class="fas fa-user-graduate me-2"></i>Student</button>
                </div>
            </div>
            <!-- Form Side -->
            <div class="col-lg-7 login-form-side">
                <h4 class="fw-bold mb-1">Welcome back</h4>
                <p class="text-muted mb-4">Sign in to your account to continue</p>

                @if (TempData["Error"] != null) {
                    <div class="alert alert-danger d-flex align-items-center gap-2 py-2"><i class="fas fa-exclamation-circle"></i>@TempData["Error"]</div>
                }

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">EMAIL ADDRESS</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fas fa-envelope text-muted"></i></span>
                            <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="your@email.com" id="loginEmail" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <label class="form-label fw-semibold small">PASSWORD</label>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fas fa-lock text-muted"></i></span>
                            <input asp-for="Password" class="form-control border-start-0 ps-0" id="loginPassword" placeholder="••••••••" />
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePw()"><i class="fas fa-eye" id="eyeIcon"></i></button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                            <label asp-for="RememberMe" class="form-check-label small">Remember me</label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-login btn-warning w-100 text-white">
                        <i class="fas fa-sign-in-alt me-2"></i>Sign In
                    </button>
                </form>

                <div class="divider mt-4">ROLE-BASED ACCESS</div>
                <div class="row g-2 text-center">
                    <div class="col-3"><div class="p-2 rounded bg-light small"><i class="fas fa-user-cog text-danger d-block mb-1"></i>Admin</div></div>
                    <div class="col-3"><div class="p-2 rounded bg-light small"><i class="fas fa-chalkboard-teacher text-primary d-block mb-1"></i>Teacher</div></div>
                    <div class="col-3"><div class="p-2 rounded bg-light small"><i class="fas fa-user-tie text-success d-block mb-1"></i>Staff</div></div>
                    <div class="col-3"><div class="p-2 rounded bg-light small"><i class="fas fa-user-graduate text-warning d-block mb-1"></i>Student</div></div>
                </div>

                <p class="text-center text-muted small mt-4 mb-0">
                    <i class="fas fa-lock me-1"></i> Secured by ASP.NET Core Identity
                </p>
            </div>
        </div>
    </div>
</div>

@* <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script> *@

<script src="~/js/bootstrap.bundle.min.js"></script>
<script src="~/js/jquery.validate.min.js"></script>

<script>
function fill(email, pw) {
    document.getElementById('loginEmail').value    = email;
    document.getElementById('loginPassword').value = pw;
}
function togglePw() {
    const inp  = document.getElementById('loginPassword');
    const icon = document.getElementById('eyeIcon');
    if (inp.type === 'password') { inp.type = 'text';     icon.className = 'fas fa-eye-slash'; }
    else                         { inp.type = 'password'; icon.className = 'fas fa-eye'; }
}
</script>
</body>
</html>
