@model Book
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Book" : "Add Book";
}
<div class="mt-4 mb-3">
    <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Library</a></li><li class="breadcrumb-item active">@(isEdit?"Edit":"Add")</li></ol></nav>
    <h1 class="h3 fw-bold"><i class="fas fa-book me-2 text-primary"></i>@(isEdit?"Edit Book":"Add New Book")</h1>
</div>
<div class="card border-0 shadow-sm" style="max-width:800px">
    <div class="card-body p-4">
        <form asp-action="@(isEdit?"Edit":"Create")" method="post">
            @Html.AntiForgeryToken()
            @if (isEdit) { <input type="hidden" asp-for="Id" /> }
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Title" class="form-label fw-semibold"></label>
                    <input asp-for="Title" class="form-control" placeholder="Full book title" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Author" class="form-label fw-semibold"></label>
                    <input asp-for="Author" class="form-control" placeholder="Author name(s)" />
                    <span asp-validation-for="Author" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ISBN" class="form-label fw-semibold"></label>
                    <input asp-for="ISBN" class="form-control" placeholder="978-..." />
                </div>
                <div class="col-md-6">
                    <label asp-for="Publisher" class="form-label fw-semibold"></label>
                    <input asp-for="Publisher" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="PublicationYear" class="form-label fw-semibold"></label>
                    <input asp-for="PublicationYear" type="number" class="form-control" placeholder="e.g. 2023" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Price" class="form-label fw-semibold"></label>
                    <div class="input-group"><span class="input-group-text">$</span><input asp-for="Price" type="number" step="0.01" class="form-control" /></div>
                </div>
                <div class="col-md-4">
                    <label asp-for="Category" class="form-label fw-semibold"></label>
                    <input asp-for="Category" class="form-control" placeholder="e.g. Mathematics, Fiction..." list="categoryList" />
                    <datalist id="categoryList">
                        @foreach (var c in new[]{"Mathematics","English","Physics","Chemistry","Biology","Computer Science","Fiction","Science","History","Geography"}) { <option value="@c" /> }
                    </datalist>
                </div>
                <div class="col-md-4">
                    <label asp-for="ShelfLocation" class="form-label fw-semibold"></label>
                    <input asp-for="ShelfLocation" class="form-control" placeholder="e.g. A-01" />
                </div>
                <div class="col-md-4">
                    <label asp-for="AccessionNo" class="form-label fw-semibold"></label>
                    <input asp-for="AccessionNo" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="TotalCopies" class="form-label fw-semibold"></label>
                    <input asp-for="TotalCopies" type="number" class="form-control" />
                    <span asp-validation-for="TotalCopies" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="AvailableCopies" class="form-label fw-semibold"></label>
                    <input asp-for="AvailableCopies" type="number" class="form-control" />
                    <span asp-validation-for="AvailableCopies" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-2"></i>@(isEdit?"Update":"Add") Book</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
