@{ 
    var student = ViewBag.Student as SchoolManagement.Models.Student;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Student Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        :root { --student-primary: #6610f2; --student-light: #f3f0ff; }
        body { background: #f4f5f7; font-family: 'Segoe UI', sans-serif; }
        .sp-sidebar { background: linear-gradient(180deg, #6610f2 0%, #520dc2 100%); width: 240px; min-height: 100vh; position: fixed; left: 0; top: 0; z-index: 100; transition: .3s; }
        .sp-sidebar .brand { padding: 1.5rem; border-bottom: 1px solid rgba(255,255,255,.15); }
        .sp-sidebar .brand h6 { color: #fff; font-weight: 700; margin: 0; font-size: .9rem; }
        .sp-sidebar .brand small { color: rgba(255,255,255,.6); font-size: .75rem; }
        .sp-nav { padding: 1rem 0; }
        .sp-nav a { display: flex; align-items: center; gap: .75rem; padding: .7rem 1.5rem; color: rgba(255,255,255,.7); text-decoration: none; font-size: .875rem; transition: .2s; border-left: 3px solid transparent; }
        .sp-nav a:hover, .sp-nav a.active { color: #fff; background: rgba(255,255,255,.12); border-left-color: #fff; }
        .sp-nav a i { width: 18px; text-align: center; }
        .sp-main { margin-left: 240px; min-height: 100vh; }
        .sp-topbar { background: #fff; border-bottom: 1px solid #e9ecef; padding: .75rem 1.5rem; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 50; }
        .student-avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--student-primary); display: inline-flex; align-items: center; justify-content: center; color: #fff; font-size: .8rem; font-weight: 700; }
        .sp-content { padding: 1.5rem; }
        @@media (max-width: 768px) { .sp-sidebar { width: 0; overflow: hidden; } .sp-main { margin-left: 0; } }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<!-- Sidebar -->
<div class="sp-sidebar">
    <div class="brand">
        <div class="d-flex align-items-center gap-2 mb-2">
            <div style="width:32px;height:32px;background:rgba(255,255,255,.2);border-radius:8px;display:flex;align-items:center;justify-content:center;">
                <i class="fas fa-graduation-cap text-white" style="font-size:.9rem"></i>
            </div>
            <h6 class="mb-0">Student Portal</h6>
        </div>
        @if (student != null) {
            <small>@student.FullName</small><br>
            <small class="opacity-50">@(student.Class?.FullName ?? "")</small>
        }
    </div>
    <nav class="sp-nav">
        <a asp-controller="StudentPortal" asp-action="Dashboard" class="@(action=="Dashboard"?"active":"")"><i class="fas fa-home"></i> Dashboard</a>
        <a asp-controller="StudentPortal" asp-action="Grades"    class="@(action=="Grades"?"active":"")"><i class="fas fa-star"></i> My Grades</a>
        <a asp-controller="StudentPortal" asp-action="Attendance" class="@(action=="Attendance"?"active":"")"><i class="fas fa-calendar-check"></i> Attendance</a>
        <a asp-controller="StudentPortal" asp-action="TimeTable" class="@(action=="TimeTable"?"active":"")"><i class="fas fa-calendar-alt"></i> Timetable</a>
        <a asp-controller="StudentPortal" asp-action="Exams"     class="@(action=="Exams"?"active":"")"><i class="fas fa-file-alt"></i> Exams</a>
        <a asp-controller="StudentPortal" asp-action="Fees"      class="@(action=="Fees"?"active":"")"><i class="fas fa-dollar-sign"></i> Fee Status</a>
        <a asp-controller="StudentPortal" asp-action="Library"   class="@(action=="Library"?"active":"")"><i class="fas fa-book-open"></i> My Books</a>
        <a asp-controller="StudentPortal" asp-action="ReportCard" class="@(action=="ReportCard"?"active":"")"><i class="fas fa-file-invoice"></i> Report Card</a>
        <hr style="border-color:rgba(255,255,255,.15);margin:.5rem 1rem;">
        <a asp-controller="Account" asp-action="Profile"><i class="fas fa-user"></i> Profile</a>
        <a asp-controller="Account" asp-action="ChangePassword"><i class="fas fa-key"></i> Change Password</a>
    </nav>
</div>

<!-- Main -->
<div class="sp-main">
    <div class="sp-topbar">
        <div class="fw-semibold text-muted small"><i class="fas fa-graduation-cap me-2 text-purple"></i>Greenwood Academy</div>
        <div class="d-flex align-items-center gap-3">
            @if (TempData["Success"] != null) {
                <span class="badge bg-success"><i class="fas fa-check me-1"></i>@TempData["Success"]</span>
            }
            <div class="d-flex align-items-center gap-2">
                <div class="student-avatar">@User.Identity!.Name!.Substring(0,1).ToUpper()</div>
                <div>
                    <div class="small fw-semibold">@(student?.FullName ?? User.Identity!.Name)</div>
                    <div style="font-size:.7rem;" class="text-muted">Student</div>
                </div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-sign-out-alt"></i></button>
            </form>
        </div>
    </div>

    <div class="sp-content">
        @RenderBody()
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
