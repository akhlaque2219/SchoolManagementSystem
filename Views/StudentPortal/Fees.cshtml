@model IEnumerable<FeePayment>
@{ Layout = "~/Views/StudentPortal/_LayoutStudent.cshtml"; ViewData["Title"] = "My Fees"; }
<h4 class="fw-bold mb-4"><i class="fas fa-dollar-sign me-2 text-success"></i>Fee Status</h4>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card border-0 shadow-sm text-center p-3"><div class="h3 fw-bold text-success">$@((decimal)ViewBag.TotalPaid)</div><div class="small text-muted">Total Paid</div></div></div>
    <div class="col-md-4"><div class="card border-0 shadow-sm text-center p-3"><div class="h3 fw-bold text-danger">$@((decimal)ViewBag.TotalDue)</div><div class="small text-muted">Amount Due</div></div></div>
    <div class="col-md-4"><div class="card border-0 shadow-sm text-center p-3"><div class="h3 fw-bold text-primary">@Model.Count()</div><div class="small text-muted">Total Records</div></div></div>
</div>
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark"><tr><th>Month</th><th>Fee Type</th><th>Amount</th><th>Paid</th><th>Balance</th><th>Method</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var sc = p.Status switch { FeeStatus.Paid => "success", FeeStatus.Overdue => "danger", FeeStatus.Partial => "warning", _ => "secondary" };
                    <tr class="@(p.Status == FeeStatus.Overdue ? "table-warning" : "")">
                        <td>@p.Month</td>
                        <td class="small">@p.FeeStructure?.Name</td>
                        <td>$@(p.FeeStructure?.Amount.ToString("N0") ?? "—")</td>
                        <td class="text-success fw-bold">$@p.AmountPaid.ToString("N0")</td>
                        <td class="@(p.Balance > 0 ? "text-danger fw-bold" : "text-success")">$@p.Balance.ToString("N0")</td>
                        <td class="small text-muted">@p.PaymentMethod</td>
                        <td><span class="badge bg-@sc">@p.Status</span></td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="7" class="text-center py-4 text-muted">No fee records</td></tr> }
            </tbody>
        </table>
    </div>
</div>
